    {
      "category": "intros",
      "id": "welcome_general",
      "text": {
        "es": "Bienvenido a Morse Practice.",
        "en": "Welcome to Morse Practice."
      },
      "use": [
        "studio",
        "course",
        "live"
      ]
    },
    {
      "category": "intros",
      "id": "welcome_relaxed",
      "text": {
        "es": "Bienvenido a Morse Practice. Relájate, escucha y concéntrate en el sonido.",
        "en": "Welcome to Morse Practice. Relax, listen, and focus on the sound."
      }
    },
    {
      "category": "intros",
      "id": "session_begins",
      "text": {
        "es": "Tu sesión está a punto de comenzar. Prepárate y concéntrate únicamente en escuchar.",
        "en": "Your session is about to begin. Get ready and focus only on listening."
      }
    },
    {
      "category": "intros",
      "id": "course_welcome",
      "text": {
        "es": "Bienvenido al curso Learn CW de Morse Practice. Aprenderás código Morse escuchando sus sonidos como unidades completas, sin memorizar puntos y rayas.",
        "en": "Welcome to the Morse Practice Learn CW course. You will learn Morse code by hearing each sound as a complete unit, without memorizing dots and dashes."
      },
      "use": [
        "course"
      ]
    },
    {
      "category": "intros",
      "id": "course_daily_guidance",
      "text": {
        "es": "No necesitas hacer varias lecciones en un solo día. Una sesión breve y concentrada es suficiente. La constancia es más importante que practicar durante muchas horas.",
        "en": "You do not need to complete several lessons in one day. One short, focused session is enough. Consistency matters more than practicing for many hours."
      },
      "use": [
        "course"
      ]
    },
    {
      "category": "instructions",
      "id": "familiarization_intro",
      "text": {
        "es": "Comenzaremos con familiarización. Primero escucharás el carácter en código Morse, luego escucharás su nombre y finalmente volverás a escucharlo. No intentes contar. Escucha el sonido completo.",
        "en": "We will begin with familiarization. First you will hear the character in Morse code, then you will hear its name, and finally you will hear it once again. Do not count. Listen to the complete sound."
      },
      "use": [
        "familiarization"
      ]
    },
    {
      "category": "instructions",
      "id": "familiarization_short",
      "text": {
        "es": "Escucha el carácter, escucha su nombre y luego vuelve a escuchar su sonido.",
        "en": "Listen to the character, hear its name, and then listen to its sound again."
      },
      "use": [
        "familiarization"
      ]
    },
    {
      "category": "instructions",
      "id": "recognition_intro",
      "text": {
        "es": "Ahora comenzaremos un ejercicio de reconocimiento. Escucha cada carácter e intenta decirlo antes de escuchar la respuesta. Si pierdes alguno, déjalo pasar y continúa con el siguiente.",
        "en": "We will now begin a recognition exercise. Listen to each character and try to say it before you hear the answer. If you miss one, let it go and continue with the next."
      },
      "use": [
        "recognition"
      ]
    },
    {
      "category": "instructions",
      "id": "recognition_variable_speed",
      "text": {
        "es": "Ahora escucharás el mismo carácter varias veces a diferentes velocidades. Intenta reconocer siempre el mismo sonido, aunque cambie su ritmo.",
        "en": "You will now hear the same character several times at different speeds. Try to recognize the same sound even as its rhythm changes."
      },
      "use": [
        "recognition",
        "variable_speed"
      ]
    },
    {
      "category": "instructions",
      "id": "recognition_say_before_answer",
      "text": {
        "es": "Intenta decir el carácter antes de escuchar la respuesta.",
        "en": "Try to say the character before you hear the answer."
      },
      "use": [
        "recognition"
      ]
    },
    {
      "category": "instructions",
      "id": "marathon_intro",
      "text": {
        "es": "Ahora comienza la sesión de escucha continua. Relájate y escucha. Si pierdes un carácter, no intentes recuperarlo. Mantén tu atención en el flujo y continúa.",
        "en": "The continuous listening session begins now. Relax and listen. If you miss a character, do not try to recover it. Stay with the flow and continue."
      },
      "use": [
        "marathon"
      ]
    },
    {
      "category": "instructions",
      "id": "groups_intro",
      "text": {
        "es": "Ahora escucharás caracteres agrupados. Escucha la secuencia completa y trata de mantener el ritmo.",
        "en": "You will now hear characters in groups. Listen to the complete sequence and try to stay with the rhythm."
      }
    },
    {
      "category": "instructions",
      "id": "no_response_required",
      "text": {
        "es": "Durante esta parte no necesitas responder en voz alta. Simplemente escucha.",
        "en": "During this part you do not need to answer out loud. Simply listen."
      }
    },
    {
      "category": "instructions",
      "id": "less_visual_help",
      "text": {
        "es": "A partir de ahora tendrás menos ayuda visual. Confía cada vez más en lo que escuchas.",
        "en": "From now on you will receive less visual help. Rely more and more on what you hear."
      },
      "use": [
        "course"
      ]
    },
    {
      "category": "context",
      "id": "begin_review",
      "text": {
